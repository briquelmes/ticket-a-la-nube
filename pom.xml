	<groupId>cl.duoc.ticketalanube</groupId>
	<artifactId>ticket-a-la-nube</artifactId>
	<version>1.0.0</version>
	<name>ticket-a-la-nube</name>
	<description>Microservicio para generar y administrar tickets de eventos</description>
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
